.venv/
__pycache__/
*.pyc

# The warehouse is a build artifact: run_pipeline.py reconstructs it from the
# raw CSVs on every run, so committing it would just be a 1.8MB binary that
# conflicts on every scheduled commit.
data/warehouse.duckdb

# Note what is deliberately absent: data/raw/. Those snapshots are the dataset,
# they cannot be refetched for a past date, and the scheduled run appends one
# per day. They are the asset this project accumulates, so they are tracked.

dashboard/index.html

# Scheduled-run logs. Useful locally for finding the morning a retailer changed
# shape; not worth carrying in the history.
logs/

# Snowflake credentials. .env.example is tracked and shows the shape; .env never
# is. The DuckDB default needs none of it, which is the point.
.env

# dbt build output. target/ is compiled SQL and run artifacts, dbt_packages/ is
# vendored dependencies restored by `dbt deps`, logs/ is dbt's own log. All three
# are regenerated by any run.
transform/dbt/target/
transform/dbt/dbt_packages/
transform/dbt/logs/
