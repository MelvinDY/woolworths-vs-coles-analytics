# Copy to .env (which is gitignored) and fill in. Only needed for the Snowflake
# target — the DuckDB default runs with none of this set.
#
#   cp .env.example .env
#   python run_pipeline.py --skip-fetch --target snowflake
#
# The account identifier is the one in your Snowflake URL, e.g. for
# https://ab12345.ap-southeast-2.aws.snowflakecomputing.com the value is
# ab12345.ap-southeast-2.aws — not the whole URL.

DBT_TARGET=duckdb

SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_ROLE=ACCOUNTADMIN
SNOWFLAKE_WAREHOUSE=GROCERY_WH
SNOWFLAKE_DATABASE=GROCERY
SNOWFLAKE_SCHEMA=ANALYTICS
